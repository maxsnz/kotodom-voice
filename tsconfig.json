{
  "compilerOptions": {
    // Bun runs TypeScript natively; tsconfig here is purely для редактора и
    // (опционально) `tsc --noEmit` type-check'а в CI. Bun сам не читает tsconfig
    // для исполнения.
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun", "node"],

    "strict": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
